@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(arisa_PLATFORM "@ARISA_PACKAGE_PLATFORM@")
set(arisa_PROVIDERS "@ARISA_PACKAGE_PROVIDERS@")
set(arisa_PLATFORM_PROVIDERS "@ARISA_PACKAGE_PLATFORM_PROVIDERS@")
set(arisa_BUILT_WITH_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(arisa_BUILT_WITH_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set_and_check(arisa_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(arisa_ASSETS_DIR "@PACKAGE_ARISA_INSTALL_ASSETSDIR@")
set_and_check(arisa_DOC_DIR "@PACKAGE_ARISA_INSTALL_DOCDIR@")
set_and_check(arisa_MODULE_INTERFACE "${arisa_INCLUDE_DIR}/arisa/arisa.cppm")

if(arisa_PLATFORM STREQUAL "switch")
    if(NOT NINTENDO_SWITCH OR NINTENDO_SWITCH2)
        set(arisa_FOUND FALSE)
        set(arisa_NOT_FOUND_MESSAGE
            "this arisa package targets the Nintendo Switch; configure with -DCMAKE_TOOLCHAIN_FILE=$DEVKITPRO/cmake/Switch.cmake")
        return()
    endif()
elseif(arisa_PLATFORM STREQUAL "switch2")
    if(NOT NINTENDO_SWITCH2)
        set(arisa_FOUND FALSE)
        set(arisa_NOT_FOUND_MESSAGE
            "this arisa package targets the Nintendo Switch 2; configure with -DCMAKE_TOOLCHAIN_FILE=$DEVKITPRO/libounce/cmake/Switch2.cmake")
        return()
    endif()
elseif(NINTENDO_SWITCH)
    set(arisa_FOUND FALSE)
    set(arisa_NOT_FOUND_MESSAGE
        "this arisa package targets ${arisa_PLATFORM}; use the switch archive under the devkitPro toolchain")
    return()
endif()

string(REGEX MATCH "^[0-9]+" arisa_built_major "${arisa_BUILT_WITH_COMPILER_VERSION}")
string(REGEX MATCH "^[0-9]+" arisa_consumer_major "${CMAKE_CXX_COMPILER_VERSION}")
if(NOT ARISA_SKIP_COMPILER_CHECK AND
   (NOT CMAKE_CXX_COMPILER_ID STREQUAL arisa_BUILT_WITH_COMPILER_ID OR
    NOT arisa_consumer_major STREQUAL arisa_built_major))
    set(arisa_FOUND FALSE)
    set(arisa_NOT_FOUND_MESSAGE
        "arisa was built with ${arisa_BUILT_WITH_COMPILER_ID} ${arisa_BUILT_WITH_COMPILER_VERSION} and needs the same compiler major version, but this project uses ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}; set ARISA_SKIP_COMPILER_CHECK to override")
    return()
endif()

find_dependency(Threads)

if("sdl3" IN_LIST arisa_PLATFORM_PROVIDERS)
    find_package(SDL3 CONFIG QUIET)
    if(NOT SDL3_FOUND AND (arisa_FIND_REQUIRED_sdl3 OR arisa_FIND_REQUIRED_module))
        set(arisa_FOUND FALSE)
        set(arisa_NOT_FOUND_MESSAGE "arisa::sdl3 needs SDL3; install SDL3 or add its prefix to CMAKE_PREFIX_PATH")
        return()
    endif()
endif()

if("vulkan" IN_LIST arisa_PLATFORM_PROVIDERS AND NOT arisa_PLATFORM STREQUAL "switch2")
    find_package(Vulkan QUIET)
    if(NOT Vulkan_FOUND AND (arisa_FIND_REQUIRED_vulkan OR arisa_FIND_REQUIRED_module))
        set(arisa_FOUND FALSE)
        set(arisa_NOT_FOUND_MESSAGE "arisa::vulkan needs the Vulkan headers and loader; install them or add their prefix to CMAKE_PREFIX_PATH")
        return()
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/arisaTargets.cmake")

if(TARGET arisa::sdl3 AND TARGET SDL3::SDL3)
    set_property(TARGET arisa::arisa APPEND PROPERTY INTERFACE_LINK_LIBRARIES SDL3::SDL3)
    set_property(TARGET arisa::sdl3 APPEND PROPERTY INTERFACE_LINK_LIBRARIES SDL3::SDL3)
endif()

if(TARGET arisa::vulkan AND TARGET Vulkan::Vulkan)
    set_property(TARGET arisa::vulkan APPEND PROPERTY INTERFACE_LINK_LIBRARIES Vulkan::Vulkan)
endif()

foreach(arisa_component IN LISTS arisa_FIND_COMPONENTS)
    if(arisa_component STREQUAL "module")
        if(CMAKE_VERSION VERSION_LESS 3.28 OR NOT CMAKE_GENERATOR MATCHES "Ninja")
            set(arisa_module_FOUND FALSE)
            set(arisa_NOT_FOUND_MESSAGE "the arisa module needs CMake 3.28 or newer and a Ninja generator")
            continue()
        endif()
        if(NOT TARGET arisa_module)
            add_library(arisa_module STATIC)
            target_sources(arisa_module PUBLIC
                FILE_SET CXX_MODULES
                BASE_DIRS "${arisa_INCLUDE_DIR}"
                FILES "${arisa_MODULE_INTERFACE}")
            target_compile_features(arisa_module PUBLIC cxx_std_23)
            set_target_properties(arisa_module PROPERTIES
                CXX_SCAN_FOR_MODULES ON
                CXX_EXTENSIONS OFF)
            set(arisa_module_links arisa::arisa)
            foreach(arisa_provider IN LISTS arisa_PROVIDERS)
                list(APPEND arisa_module_links arisa::${arisa_provider})
            endforeach()
            target_link_libraries(arisa_module PUBLIC ${arisa_module_links})
            add_library(arisa::module ALIAS arisa_module)
        endif()
        set(arisa_module_FOUND TRUE)
    elseif(arisa_component STREQUAL "sdl3")
        if(TARGET arisa::sdl3 AND TARGET SDL3::SDL3)
            set(arisa_sdl3_FOUND TRUE)
        else()
            set(arisa_sdl3_FOUND FALSE)
        endif()
    elseif(arisa_component STREQUAL "vulkan" AND NOT arisa_PLATFORM STREQUAL "switch2")
        if(TARGET arisa::vulkan AND TARGET Vulkan::Vulkan)
            set(arisa_vulkan_FOUND TRUE)
        else()
            set(arisa_vulkan_FOUND FALSE)
        endif()
    elseif(TARGET arisa::${arisa_component})
        set(arisa_${arisa_component}_FOUND TRUE)
    else()
        set(arisa_${arisa_component}_FOUND FALSE)
    endif()
endforeach()

check_required_components(arisa)
