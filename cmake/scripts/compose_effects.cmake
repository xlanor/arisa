cmake_minimum_required(VERSION 3.28)

foreach(required BASE LIST OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "compose_effects.cmake needs -D${required}=")
    endif()
endforeach()

file(READ "${BASE}" base)
set(entries "")
if(EXISTS "${LIST}")
    file(STRINGS "${LIST}" entries)
endif()
set(functions "")
set(dispatch "")
foreach(entry IN LISTS entries)
    if(entry STREQUAL "")
        continue()
    endif()
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 index)
    list(GET parts 1 kind)
    list(GET parts 2 function)
    list(GET parts 3 path)
    file(READ "${path}" body)
    string(APPEND functions "${body}\n")
    if(kind STREQUAL "colour")
        set(call "${function}(position, arisa_layer(position))")
    elseif(kind STREQUAL "distortion")
        set(call "arisa_layer(${function}(position))")
    elseif(kind STREQUAL "layer")
        set(call "${function}(position)")
    else()
        message(FATAL_ERROR "effect ${function} has kind ${kind}; expected colour, distortion or layer")
    endif()
    string(APPEND dispatch "  if (index == ${index}) {\n    return ${call};\n  }\n")
endforeach()
file(WRITE "${OUTPUT}.tmp" "${base}\n${functions}\nvec4 arisa_effect(int index, vec2 position)\n{\n${dispatch}  return arisa_layer(position);\n}\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
